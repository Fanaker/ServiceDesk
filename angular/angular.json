{
  "$schema":"./node_modules/@angular/cli/lib/config/schema.json",
  "version":1,
  "newProjectRoot":"projects",
  "projects":{
    "servicedesk":{
      "projectType":"application",
      "root":"",
      "sourceRoot":"src",
      "prefix":"app",
      "architect":{
        "build":{
          "builder":"@angular/build:application",
          "options":{
            "browser":"src/main.ts",
            "index":"src/index.html",
            "tsConfig":"tsconfig.app.json",
            "polyfills":["zone.js"],
            "styles":["src/styles.css"],
            "assets":[]
          },
          "configurations":{"production":{"optimization":true,"outputHashing":"all"},"development":{"optimization":false,"sourceMap":true}},
          "defaultConfiguration":"production"
        },
        "serve":{"builder":"@angular/build:dev-server","configurations":{"production":{"buildTarget":"servicedesk:build:production"},"development":{"buildTarget":"servicedesk:build:development"}},"defaultConfiguration":"development"}
      }
    }
  },
  "cli":{"analytics":false}
}
